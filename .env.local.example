# =============================================================================
# Glicemia App — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o arquivo .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# Obtenha em: https://supabase.com/dashboard → seu projeto → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Anthropic
# Obtenha em: https://console.anthropic.com/api-keys
# Modelo recomendado: claude-sonnet-4-5 (balanceamento custo/qualidade)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
